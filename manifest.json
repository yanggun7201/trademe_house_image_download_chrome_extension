{
  "manifest_version": 3,
  "name": "TradeMe House Image Downloader",
  "version": "0.1.0",
  "description": "Download all photos from a TradeMe residential listing page to a folder you pick.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://trademe.tmcdn.co.nz/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
